{
  "type": "function",
  "function": {
    "name": "draft_post",
    "description": "Write one social post and save it as a pending_approval task (optionally scheduled). Nothing is published.",
    "parameters": {
      "type": "object",
      "properties": {
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "x",
              "instagram",
              "facebook",
              "linkedin",
              "youtube",
              "blog"
            ]
          },
          "minItems": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 30
        },
        "poster_idea": {
          "type": "string",
          "maxLength": 600
        },
        "image_brief": {
          "type": "object",
          "description": "Image brief for the post picture (always include it).",
          "properties": {
            "headline": {
              "type": "string",
              "maxLength": 80,
              "description": "Big text on the image, max 8 words"
            },
            "subline": {
              "type": "string",
              "maxLength": 160,
              "description": "One short supporting line"
            },
            "cta": {
              "type": "string",
              "maxLength": 30,
              "description": "Button text, e.g. 'Download now'"
            },
            "style": {
              "type": "string",
              "maxLength": 300,
              "description": "Look and mood: colours, photo vs. graphic, subject"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "description": "2-4 stock-photo search words, e.g. ['smartphone', 'bookmarks']"
            }
          }
        },
        "scheduled_at": {
          "type": "string",
          "description": "ISO 8601 local date-time, e.g. 2026-10-20T18:30 (user timezone if no offset)"
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "brand": {
          "type": "string"
        }
      },
      "required": [
        "platforms",
        "caption"
      ],
      "additionalProperties": false
    }
  }
}
