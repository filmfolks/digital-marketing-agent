{
  "type": "function",
  "function": {
    "name": "update_task",
    "description": "Edit a task's text, platforms, title, hashtags or poster idea. Cannot approve; edits to an approved post send it back for approval.",
    "parameters": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 3
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "content": {
          "type": "string",
          "maxLength": 5000
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "x",
              "instagram",
              "facebook",
              "linkedin",
              "youtube",
              "blog"
            ]
          }
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "poster_idea": {
          "type": "string",
          "maxLength": 600
        },
        "instruction": {
          "type": "string",
          "maxLength": 2000
        },
        "image_brief": {
          "type": "object",
          "description": "Image brief for the post picture (always include it).",
          "properties": {
            "headline": {
              "type": "string",
              "maxLength": 80,
              "description": "Big text on the image, max 8 words"
            },
            "subline": {
              "type": "string",
              "maxLength": 160,
              "description": "One short supporting line"
            },
            "cta": {
              "type": "string",
              "maxLength": 30,
              "description": "Button text, e.g. 'Download now'"
            },
            "style": {
              "type": "string",
              "maxLength": 300,
              "description": "Look and mood: colours, photo vs. graphic, subject"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "description": "2-4 stock-photo search words, e.g. ['smartphone', 'bookmarks']"
            }
          }
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  }
}
