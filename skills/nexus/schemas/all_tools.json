[
  {
    "type": "function",
    "function": {
      "name": "create_task",
      "description": "Create a task on the calendar (a post to prepare or a reminder). It is saved as pending_approval; a human approves it before anything is posted.",
      "parameters": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "instruction": {
            "type": "string",
            "maxLength": 2000,
            "description": "What should be done"
          },
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "x",
                "instagram",
                "facebook",
                "linkedin",
                "youtube",
                "blog"
              ]
            }
          },
          "content": {
            "type": "string",
            "maxLength": 5000,
            "description": "Post text if already written"
          },
          "scheduled_at": {
            "type": "string",
            "description": "ISO 8601 local date-time, e.g. 2026-10-20T18:30 (user timezone if no offset)"
          },
          "brand": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "draft_post",
      "description": "Write one social post and save it as a pending_approval task (optionally scheduled). Nothing is published.",
      "parameters": {
        "type": "object",
        "properties": {
          "platforms": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "x",
                "instagram",
                "facebook",
                "linkedin",
                "youtube",
                "blog"
              ]
            },
            "minItems": 1
          },
          "caption": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "hashtags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30
          },
          "poster_idea": {
            "type": "string",
            "maxLength": 600
          },
          "image_brief": {
            "type": "object",
            "description": "Image brief for the post picture (always include it).",
            "properties": {
              "headline": {
                "type": "string",
                "maxLength": 80,
                "description": "Big text on the image, max 8 words"
              },
              "subline": {
                "type": "string",
                "maxLength": 160,
                "description": "One short supporting line"
              },
              "cta": {
                "type": "string",
                "maxLength": 30,
                "description": "Button text, e.g. 'Download now'"
              },
              "style": {
                "type": "string",
                "maxLength": 300,
                "description": "Look and mood: colours, photo vs. graphic, subject"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "maxItems": 6,
                "description": "2-4 stock-photo search words, e.g. ['smartphone', 'bookmarks']"
              }
            }
          },
          "scheduled_at": {
            "type": "string",
            "description": "ISO 8601 local date-time, e.g. 2026-10-20T18:30 (user timezone if no offset)"
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "brand": {
            "type": "string"
          }
        },
        "required": [
          "platforms",
          "caption"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "schedule_task",
      "description": "Set or change the date/time of an existing task.",
      "parameters": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 3
          },
          "scheduled_at": {
            "type": "string",
            "description": "ISO 8601 local date-time, e.g. 2026-10-20T18:30 (user timezone if no offset)"
          }
        },
        "required": [
          "task_id",
          "scheduled_at"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "plan_campaign",
      "description": "Plan a campaign (e.g. a whole month): returns many dated posts with captions, SEO hashtags and poster ideas. Every post becomes a pending_approval task.",
      "parameters": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "goal": {
            "type": "string",
            "maxLength": 500
          },
          "brand": {
            "type": "string"
          },
          "start": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "end": {
            "type": "string",
            "description": "YYYY-MM-DD"
          },
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "scheduled_at": {
                  "type": "string",
                  "description": "ISO 8601 local date-time, e.g. 2026-10-20T18:30 (user timezone if no offset)"
                },
                "platforms": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "x",
                      "instagram",
                      "facebook",
                      "linkedin",
                      "youtube",
                      "blog"
                    ]
                  },
                  "minItems": 1
                },
                "title": {
                  "type": "string",
                  "maxLength": 120
                },
                "caption": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2200,
                  "description": "Final post text"
                },
                "hashtags": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 30
                },
                "poster_idea": {
                  "type": "string",
                  "maxLength": 600,
                  "description": "Visual / poster concept"
                },
                "image_brief": {
                  "type": "object",
                  "description": "Image brief for the post picture (always include it).",
                  "properties": {
                    "headline": {
                      "type": "string",
                      "maxLength": 80,
                      "description": "Big text on the image, max 8 words"
                    },
                    "subline": {
                      "type": "string",
                      "maxLength": 160,
                      "description": "One short supporting line"
                    },
                    "cta": {
                      "type": "string",
                      "maxLength": 30,
                      "description": "Button text, e.g. 'Download now'"
                    },
                    "style": {
                      "type": "string",
                      "maxLength": 300,
                      "description": "Look and mood: colours, photo vs. graphic, subject"
                    },
                    "keywords": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      },
                      "maxItems": 6,
                      "description": "2-4 stock-photo search words, e.g. ['smartphone', 'bookmarks']"
                    }
                  }
                }
              },
              "required": [
                "scheduled_at",
                "platforms",
                "caption"
              ]
            },
            "minItems": 1,
            "maxItems": 62
          }
        },
        "required": [
          "name",
          "posts"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_tasks",
      "description": "List tasks, optionally filtered by status, brand or date range.",
      "parameters": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "pending_approval",
              "approved",
              "running",
              "done",
              "failed",
              "cancelled"
            ]
          },
          "brand": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "additionalProperties": false
      }
    }
  },
