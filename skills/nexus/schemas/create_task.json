{
  "type": "function",
  "function": {
    "name": "create_task",
    "description": "Create a task on the calendar (a post to prepare or a reminder). It is saved as pending_approval; a human approves it before anything is posted.",
    "parameters": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instruction": {
          "type": "string",
          "maxLength": 2000,
          "description": "What should be done"
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "x",
              "instagram",
              "facebook",
              "linkedin",
              "youtube",
              "blog"
            ]
          }
        },
        "content": {
          "type": "string",
          "maxLength": 5000,
          "description": "Post text if already written"
        },
        "scheduled_at": {
          "type": "string",
          "description": "ISO 8601 local date-time, e.g. 2026-10-20T18:30 (user timezone if no offset)"
        },
        "brand": {
          "type": "string"
        }
      },
      "required": [
        "title"
      ],
      "additionalProperties": false
    }
  }
}
