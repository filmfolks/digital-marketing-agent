{
  "type": "function",
  "function": {
    "name": "regenerate_task_image",
    "description": "Redo a task's picture with changes the user asked for (new headline/subline/CTA text, colours, style, stock keywords or source). Regenerating the image of an approved post sends it back for approval.",
    "parameters": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "minLength": 3
        },
        "edits": {
          "type": "object",
          "description": "What to change on the image. Only send what changes.",
          "properties": {
            "headline": {
              "type": "string",
              "maxLength": 80
            },
            "subline": {
              "type": "string",
              "maxLength": 160
            },
            "cta": {
              "type": "string",
              "maxLength": 30
            },
            "style": {
              "type": "string",
              "maxLength": 300
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 6
            },
            "bg": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Background colour #RRGGBB"
            },
            "bg2": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Second gradient colour"
            },
            "fg": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Text colour"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$",
              "description": "Button/accent colour"
            },
            "provider": {
              "type": "string",
              "enum": [
                "openai",
                "gemini",
                "xai",
                "canva",
                "stock",
                "card"
              ],
              "description": "Force one source; 'card' = offline text card (always works)"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "task_id"
      ],
      "additionalProperties": false
    }
  }
}
