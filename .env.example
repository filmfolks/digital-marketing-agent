# ==============================================================================
# Digital Marketing Agent - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Provider Configuration
# Supported providers: auto | lmstudio | ollama | gemini | groq | claude | deepseek | openai
# ------------------------------------------------------------------------------
AI_PROVIDER=auto

# Local Model Settings (LM Studio / Ollama / Hermes)
# LM Studio default: http://localhost:1234/v1
# Ollama default:    http://localhost:11434/v1
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=hermes-3-llama-3.1-8b

# Cloud API Keys
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Social Media & Content Publishing Credentials
# ------------------------------------------------------------------------------
# Meta / Instagram Graph API
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Twitter / X API v2
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# LinkedIn API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Blogger API v3
BLOGGER_BLOG_ID=
BLOGGER_ACCESS_TOKEN=

# Canva Connect API
CANVA_CLIENT_ID=
