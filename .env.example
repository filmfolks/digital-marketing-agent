# ==============================================================================
# Digital Marketing Agent (Nexus) — Environment Configuration
#
#   cp .env.example .env      # then fill in only the sections you use
#
# Nothing here is required to open the UI. Every value is OPTIONAL: the app is
# local-first and its keys usually live in the browser (Settings → Save Key for
# Provider / Connected Accounts). This file is for CLI, cron and MCP runs, which
# have no browser to read from.
#
# .env is git-ignored. Never commit it.
# ==============================================================================


# ------------------------------------------------------------------------------
# 1. AI provider selection
#    NEXUS_PROVIDER is the default for MCP/agent runs (nexus_mcp.py reads it).
#    AI_PROVIDER is the default for the generate_content.py CLI.
#
#    Supported: auto | lmstudio | ollama | gemini | groq | claude |
#               deepseek | openai | xai | openrouter | qwen
#
#    `auto` probes in this order: LM Studio (1234) → Ollama (11434) → the first
#    cloud key present below (gemini, groq, deepseek, openai, claude, xai,
#    openrouter, qwen) → LM Studio. Note it PREFERS a running local server over a
#    cloud key, so set an explicit provider when the choice matters.
# ------------------------------------------------------------------------------
AI_PROVIDER=auto
NEXUS_PROVIDER=auto

# Brand name used by MCP tools (generate_content, antigravity directives) when the
# caller does not pass one. The UI uses Settings → Brand Name instead.
NEXUS_BRAND=My Brand

# Free-form label shown by the Telegram /status command.
NEXUS_ENGINE=cloud(xAI Grok default chain)


# ------------------------------------------------------------------------------
# 2. Local model servers
#    Both speak the OpenAI chat-completions protocol. Either a base URL or the
#    full /chat/completions path is accepted — the CLI normalises both.
# ------------------------------------------------------------------------------
LM_STUDIO_URL=http://localhost:1234/v1
OLLAMA_URL=http://localhost:11434/v1
# Default model for local runs. Override per-run with generate_content.py --model.
LOCAL_MODEL_NAME=hermes-3-llama-3.1-8b


# ------------------------------------------------------------------------------
# 3. Cloud AI provider keys
#    Each key is sent ONLY to its own vendor's endpoint. An unknown provider id
#    raises instead of falling back to another vendor, so a key can never be
#    POSTed to the wrong company.
#
#    Get a key:  GEMINI      https://aistudio.google.com/app/apikey
#                GROQ        https://console.groq.com/keys
#                ANTHROPIC   https://console.anthropic.com/settings/keys
#                DEEPSEEK    https://platform.deepseek.com/api_keys
#                QWEN        https://bailian.console.aliyun.com/
#                OPENAI      https://platform.openai.com/api-keys
#                XAI         https://console.x.ai/
#                OPENROUTER  https://openrouter.ai/keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=


# ------------------------------------------------------------------------------
# 4. Local relay (agent/nexus_relay.py)
#    The browser cannot execute Python, so the UI calls this loopback-only bridge
#    to run browser automation, publishing and MCP tools.
#
#    NEXUS_RELAY_TOKEN is strongly recommended: it makes every non-GET request
#    require the X-Nexus-Token header. Generate one with:
#        python3 agent/nexus_relay.py --generate-token
#    then paste the same value into Settings → Relay token in the UI.
#
#    The relay binds 127.0.0.1 ONLY and never 0.0.0.0, whatever port you pick.
# ------------------------------------------------------------------------------
NEXUS_RELAY_PORT=8712
NEXUS_RELAY_TOKEN=


# ------------------------------------------------------------------------------
# 5. Telegram bot (agent/telegram_bot.py)
#    TELEGRAM_BOT_TOKEN is the credential — anyone holding it controls the bot.
#    Revoke it with @BotFather → /revoke if it ever leaks.
#
#    Access is restricted to the chat ids below; anyone else is refused and
#    logged. State-changing commands still need an in-chat tap-to-approve.
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Extra allowed chat ids, comma-separated (optional).
NEXUS_TG_ALLOWLIST=


# ------------------------------------------------------------------------------
# 6. Social publishing credentials (agent/publish.py)
#    These fallbacks are used when a job payload from the relay does not carry
#    per-platform credentials — handy for cron runs and MCP publish_post calls.
#    The UI normally supplies its own from Connected Accounts.
# ------------------------------------------------------------------------------

# Meta / Instagram Graph API  (Facebook Page + Instagram Business account)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
FACEBOOK_PAGE_ID=

# Twitter / X API v2
# NOTE: creating a post requires USER-CONTEXT OAuth (OAuth 1.0a, or OAuth 2.0
# with the tweet.write scope). An app-only TWITTER_BEARER_TOKEN can only READ —
# using it to post returns 403.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# LinkedIn API  (LINKEDIN_PERSON_URN looks like urn:li:person:xxxx)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=

# YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# Blogger API v3
BLOGGER_BLOG_ID=
BLOGGER_ACCESS_TOKEN=


# ------------------------------------------------------------------------------
# 7. Canva Connect API (Canva Studio)
#
#    Paste these into the UI (Connected Accounts -> Canva Studio) rather than
#    here: the OAuth flow runs in the browser and stores tokens in localStorage.
#
#    The OAuth redirect URI is NOT an environment variable — it is a field in the
#    Canva Studio panel, must match your Canva app registration exactly, and must
#    be the URL the UI is served from. Example:
#        http://localhost:8080/index.html
#    Leave it blank to fall back to the current page URL.
#    The flow uses PKCE (S256) with a fresh per-tab code_verifier.
# ------------------------------------------------------------------------------
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=

# ══════════════════════════════════════════════════════════════════════════════
#  Publishing: API first, browser fallback
# ══════════════════════════════════════════════════════════════════════════════
# 1 = when an official API call fails (missing keys, 4xx, 5xx, rate limit after
#     retries) publish through your logged-in browser profile instead.
NEXUS_BROWSER_FALLBACK=1
NEXUS_API_RETRIES=2          # extra API attempts for 429/5xx/network errors
NEXUS_BROWSER_RETRIES=1      # extra browser attempts (never for "logged out")
NEXUS_BACKOFF_BASE=2         # seconds; doubles each retry, ±25% jitter
NEXUS_X_LONG_POST=0          # 1 if your X account has Premium/Premium+ (posts >280 chars)
# NEXUS_BROWSER_CHANNEL=     # chrome | msedge | chromium  (default: auto-detect)
# NEXUS_PROFILES_DIR=        # default logs/profiles/<platform>
# NEXUS_PACE=1               # human pacing multiplier (0 disables delays)
# NEXUS_TIMEOUT_SCALE=1      # multiply element waits on slow connections
# NEXUS_LOG_FORMAT=json      # structured relay access logs

# ── Phone / LAN access (see TESTING.md and README "Phone as a client") ───────
# NEXUS_RELAY_LAN=1          # listen on all interfaces; requires a 24+ char token
# NEXUS_TLS_CERT=certs/nexus.pem
# NEXUS_TLS_KEY=certs/nexus-key.pem
# NEXUS_ALLOWED_ORIGINS=https://nexus.example.com

# ── Brand Setup (agent/brand_research.py, dashboard "Brand Setup" page) ──────
# Places API (New) key for Google Business Profile data. Without it the relay
# reads the public Maps listing in the browser (best-effort).
GOOGLE_PLACES_API_KEY=
# NEXUS_CRAWL_MAX_PAGES=15     # pages per website crawl (robots.txt always obeyed)
# NEXUS_RESEARCH_MODEL=        # override the model used for profile/plan generation
# NEXUS_BRANDS_DIR=data/brands # where brand profiles/plans are stored (gitignored)
# NEXUS_CRAWLER_UA=            # crawler User-Agent (identifies itself as NexusBrandResearch)

# ── Brains, logs, attach mode ──────────────────────────────────────────────────
# NEXUS_CDP_URL=http://127.0.0.1:9222   # drive YOUR running Chrome (--remote-debugging-port=9222); "off" = own profile browser
# NEXUS_CDP_PORT=9222
# NEXUS_ANTIGRAVITY_TIMEOUT=300         # seconds for one Antigravity live-brain answer
# NEXUS_ANTIGRAVITY_LS=                 # path to Antigravity's language_server(.exe) if not auto-discovered
# NEXUS_ACTIVITY_LOG=                   # default data/brands/<brand>/activity_log.jsonl
# NEXUS_LINK_MEMORY=                    # default data/brands/<brand>/link_memory.json
# NEXUS_AUDIT_LOG=                      # default logs/browser_audit.jsonl
# NEXUS_BRAIN=                          # label written to the activity log (default "Nexus")
# NEXUS_CLIENT_CONFIG=                  # client builds only: path to config/client.json
# NEXUS_DAEMON_LABEL=com.nexus.agent    # macOS LaunchAgent label (use a different one per Nexus folder)
